# RazorShield local configuration
# Copy to .env and adjust. Never commit real credentials.

APP_NAME=RazorShield
APP_ENV=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
POSTGRES_USER=razorshield
POSTGRES_PASSWORD=razorshield_dev_only
POSTGRES_DB=razorshield
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://razorshield:razorshield_dev_only@localhost:5432/razorshield

# Model
MODEL_DIR=models
ACTIVE_MODEL_VERSION=risk-model-v1

# Policy (thresholds overwritten by trained artifacts when present)
POLICY_VERSION=policy-v1
HIGH_RISK_ACTION=BLOCK
BLOCK_AMOUNT_MIN=25000

# Illustrative synthetic cost assumptions (not real-world economics)
COST_FRAUD_LOSS_MULTIPLIER=1.0
COST_REVIEW=120
COST_CUSTOMER_FRICTION=80
COST_BLOCKED_LEGITIMATE=400

# Demo
DEMO_SEED=42
